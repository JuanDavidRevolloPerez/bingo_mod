# ============================================================
# BINGO ONLINE - Variables de Entorno
# ============================================================
# Copia este archivo como ".env" y ajusta los valores
# para tu entorno local o de producción.
# NUNCA subas ".env" a Git (ya está en .gitignore).
# ============================================================

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bingo_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/bingo_mod-2.2/bingo_mod-2.2/php/auth/google.php

# Configuración de la aplicación
APP_ENV=local
APP_DEBUG=true

# Webhook Secret Key (para validación de webhooks de pasarelas de pago)
WEBHOOK_SECRET_KEY=sec_events_bingo_prod_test
