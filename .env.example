# ============================================================
# BINGO ONLINE - Variables de Entorno
# ============================================================
# Copia este archivo como ".env" y ajusta los valores
# para tu entorno local o de producción.
# NUNCA subas ".env" a Git (ya está en .gitignore).
# ============================================================

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bingo_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Google OAuth 2.0
# ------------------------------------------------------------
# 1. Crea un proyecto en https://console.cloud.google.com
# 2. APIs & Services > Credentials > Create Credentials > OAuth Client ID
# 3. Tipo: "Web application"
# 4. Authorized redirect URIs (añade TODAS las que uses):
#    - http://localhost/bingo_mod-2.2/bingo_mod-2.2/php/auth/google.php
#    - https://TU_SUBDOMINIO.ngrok-free.dev/php/auth/google.php
#    - https://TU_DOMINIO.com/php/auth/google.php
# 5. Copia Client ID y Client Secret aquí abajo
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URI de redirección: se calcula automáticamente según el host de la petición.
# Déjala VACÍA para usar el cálculo dinámico (recomendado).
# Si la defines, tiene prioridad sobre el cálculo automático.
GOOGLE_REDIRECT_URI=

# Hosts permitidos para el callback de Google (whitelist de seguridad).
# Google rechaza IPs crudas (192.168.x.x) y http:// no-localhost.
# Para probar desde el móvil, usa un túnel HTTPS (ngrok, cloudflare, etc.)
# y añade su subdominio aquí.
GOOGLE_ALLOWED_HOSTS=localhost,127.0.0.1

# Host canónico para el callback (opcional).
# Úsalo si quieres fijar la URL aunque el túnel cambie de subdominio.
# Ej: APP_BASE_URL=https://mi-dominio.com
APP_BASE_URL=

# Fuerza el esquema de la URI de redirección: true | false | (vacío = automático).
# Automático: http:// solo para localhost, https:// para cualquier otro host.
APP_FORCE_HTTPS=

# Configuración de la aplicación
APP_ENV=local
APP_DEBUG=true

# Webhook Secret Key (para validación de webhooks de pasarelas de pago)
WEBHOOK_SECRET_KEY=sec_events_bingo_prod_test
